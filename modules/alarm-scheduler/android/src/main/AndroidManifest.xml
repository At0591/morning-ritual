<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <!--
    Exact alarms: USE_EXACT_ALARM is granted automatically to alarm-clock apps
    on Android 13+ (Play policy allows it for "an alarm or timer app").
    SCHEDULE_EXACT_ALARM only covers Android 12 / 12L, which lack USE_EXACT_ALARM.
  -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

  <!--
    AlarmRingService keeps a ringing alarm going in the background. Its type is
    systemExempted, which Android reserves for apps holding an exact-alarm
    permission that use a foreground service to continue alarms (Android 14
    behaviour changes). mediaPlayback was wrong: Play requires that playback
    to be started by the user, and an alarm isn't.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <!--
    "Display over other apps": only requested on phone brands whose skins reject
    full-screen alarms (Vivo/iQOO OriginOS, Xiaomi, Oppo, Realme). It lets the
    ringer open the wake-up screen itself. The user grants it in Settings.
  -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <application>
    <!--
      AlarmFireReceiver is what AlarmManager.setAlarmClock() targets. It runs
      even if the app is killed, the phone is locked or in Doze.
      BootCompletedReceiver re-arms pending alarms after a reboot.
    -->
    <receiver
        android:name="expo.modules.alarmscheduler.AlarmFireReceiver"
        android:exported="false">
      <intent-filter>
        <action android:name="expo.modules.alarmscheduler.FIRE" />
      </intent-filter>
    </receiver>
    <receiver
        android:name="expo.modules.alarmscheduler.BootCompletedReceiver"
        android:exported="true"
        android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>
    <service
        android:name="expo.modules.alarmscheduler.AlarmRingService"
        android:exported="false"
        android:foregroundServiceType="systemExempted" />
  </application>
</manifest>
